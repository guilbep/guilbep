# Copy this file to `.env` and fill in real values.
# Loaded by the Makefile via `include .env`.

# SFTP credentials used by `make deploy` (lftp).
# Login (username) on the SFTP host.
LFTP_LOGIN=
# Fully-qualified hostname of the SFTP server (no scheme, no path).
LFTP_FQDN=
# SFTP password. lftp reads it via `--env-password`, so it must be exported.
LFTP_PASSWORD=

# Note: IMAGE_VERSION and DOCKER_CONFIG_PATH are computed inside the Makefile
# (git tag and `$(pwd)` respectively), so they don't need to be set here.
