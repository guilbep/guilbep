<header class="top">
  <a class="mark" href="{{ getRouteUrl('landing_page') }}" aria-label="Home">PG</a>
  <nav class="page-nav" aria-label="Sections">
    {% for item in navItems %}
      <a href="{{ item.path }}"{% if page.key == item.key %} aria-current="page"{% endif %}>{{ item.title }}</a>
    {% endfor %}
  </nav>
  <nav class="socials" aria-label="Social links">
    <ul>
      <li><a href="{{ t('links.github') }}" rel="me noopener" aria-label="GitHub">GH</a></li>
      <li><a href="{{ t('links.email') }}" aria-label="Email">@</a></li>
      <li><a href="{{ t('links.gitlab') }}" rel="me noopener" aria-label="GitLab">GL</a></li>
    </ul>
  </nav>
  <nav class="locales" aria-label="{{ t('language_switcher.label') }}">
    {% for l in alternates %}
      {% if not isCurrentLocale(l) %}
        <a href="{{ getLocalizedUrl(currentPage, l) }}" hreflang="{{ l }}" lang="{{ l }}">{{ t('language_switcher.' + l) }}</a>
      {% endif %}
    {% endfor %}
  </nav>
</header>
