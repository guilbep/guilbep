<header class="top">
  <a class="mark" href="{{ getRouteUrl('landing_page') }}" aria-label="Home">
    <img src="/favicon.svg" alt="" width="32" height="32">
  </a>
  <nav class="page-nav" aria-label="Sections">
    {% for item in navItems %}
      <a href="{{ item.path }}"{% if page.key == item.key %} aria-current="page"{% endif %}>{{ item.title }}</a>
    {% endfor %}
  </nav>
  <nav class="socials" aria-label="Social links">
    <ul>
      <li><a href="{{ t('links.github') }}" rel="me noopener" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.3c-2.23.48-2.7-1.07-2.7-1.07-.37-.93-.9-1.18-.9-1.18-.73-.5.06-.49.06-.49.8.06 1.23.82 1.23.82.72 1.23 1.88.88 2.34.67.07-.52.28-.88.5-1.08-1.78-.2-3.64-.89-3.64-3.96 0-.88.31-1.6.82-2.16-.08-.2-.36-1.01.08-2.11 0 0 .67-.22 2.2.82A7.6 7.6 0 0 1 8 4.18c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.91.08 2.11.51.56.82 1.28.82 2.16 0 3.08-1.87 3.76-3.65 3.96.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a></li>
      <li><a href="{{ t('links.email') }}" aria-label="Email" title="Email"><svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M2 3h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm0 1v.4l6 3.6 6-3.6V4H2zm12 1.78L8.5 9.17a1 1 0 0 1-1 0L2 5.78V12h12V5.78z"/></svg></a></li>
      <li><a href="{{ t('links.gitlab') }}" rel="me noopener" aria-label="GitLab" title="GitLab"><svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 14.5 5 7H3l-1 3.2a.5.5 0 0 0 .18.56L8 14.5 13.82 10.76A.5.5 0 0 0 14 10.2L13 7h-2l-3 7.5z"/><path d="M5 7 6 1.5h4L11 7H5z"/></svg></a></li>
    </ul>
  </nav>
  <nav class="locales" aria-label="{{ t('language_switcher.label') }}">
    {% for l in alternates %}
      <a href="{{ getLocalizedUrl(currentPage, l) }}" {% if isCurrentLocale(l) %}aria-current="page"{% endif %}>{{ t('language_switcher.' + l) }}</a>
    {% endfor %}
  </nav>
</header>
