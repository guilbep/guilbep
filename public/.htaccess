# Long cache for static content-addressed / rarely-changing assets.
# Lighthouse flagged /favicon.svg at 4h TTL; bumping these up to a year.
<IfModule mod_headers.c>
  <FilesMatch "\.(svg|ico|png|jpg|jpeg|webp|avif|woff2?|ttf|css|js|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # PDFs change occasionally; medium cache.
  <FilesMatch "\.(pdf|vcf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
